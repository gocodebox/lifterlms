      "content": "<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\"}},\"border\":{\"radius\":\"15px\"},\"color\":{\"background\":\"#abb7c221\"}},\"layout\":{\"type\":\"constrained\"},\"llms_visibility\":\"enrolled\",\"llms_visibility_in\":\"this\"} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:15px;background-color:#abb7c221;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\"><!-- wp:heading {\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Course Progress</h2>\n<!-- /wp:heading -->\n\n<!-- wp:llms/course-progress /-->\n\n<!-- wp:llms/course-continue-button -->\n<div class=\"wp-block-llms-course-continue-button\" style=\"text-align:center\">[lifterlms_course_continue_button]</div>\n<!-- /wp:llms/course-continue-button --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p>Use this Free Course Lead Magnet Template as the basis for your own free course using the <a href=\"https://lifterlms.com/blog/best-wordpress-lms-plugins/\">best WordPress LMS plugins</a>. A free course lets you start<strong> building your email list</strong>, <strong>gets users on your site</strong>, and <strong>encourages learners to enroll in other courses or memberships</strong>.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"left\"} -->\n<p class=\"has-text-align-left\" id=\"block-87651e8c-a55c-48b0-9bf7-4d2aa6577530\">&#x1f449;  <a href=\"https://lifterlms.com/docs/getting-started-with-the-free-course-lead-magnet-template/\" target=\"_blank\" rel=\"noreferrer noopener\">Learn how to use this template in the LifterLMS documentation area</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:spacer {\"height\":\"20px\"} -->\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:heading {\"textAlign\":\"left\"} -->\n<h2 class=\"wp-block-heading has-text-align-left\">Mini Course Headline</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"left\"} -->\n<p class=\"has-text-align-left\">Discover how to get [RESULT] without [COMMOM PROBLEM / OBJECTION]. Expand on this section with a short description of your free course.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:spacer {\"height\":\"20px\"} -->\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:llms/pricing-table /-->\n\n<!-- wp:spacer {\"height\":\"20px\"} -->\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"style\":{\"color\":{\"background\":\"#abb7c221\"},\"border\":{\"radius\":\"15px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|20\",\"right\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|20\",\"left\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:15px;background-color:#abb7c221;padding-top:var(--wp--preset--spacing--20);padding-right:var(--wp--preset--spacing--20);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--20)\"><!-- wp:llms/course-information {\"title_size\":\"h2\"} /-->\n\n<!-- wp:separator {\"backgroundColor\":\"primary-lighter\",\"className\":\"is-style-wide\"} -->\n<hr class=\"wp-block-separator has-text-color has-primary-lighter-color has-alpha-channel-opacity has-primary-lighter-background-color has-background is-style-wide\"/>\n<!-- /wp:separator -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Who is this course for?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>Target audience #1</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Target audience #2</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Target audience #3</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>Synopsis of who this course is for.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Why choose this course?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol><!-- wp:list-item -->\n<li><strong>Course Benefit:</strong> Description of course benefit.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Course Benefit:</strong> Description of course benefit.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Course Benefit:</strong> Description of course benefit.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"20px\"} -->\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:llms/course-syllabus {\"llms_visibility_in\":\"this\"} /-->",
