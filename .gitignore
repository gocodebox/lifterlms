# Exclude maps.
/blocks/**/*.js.map
/assets/css/*.map
/assets/js/*.map
/assets/maps/*

# Misc.
*.log
.DS_Store

# Release distribution directory.
/dist/
/tmp/

# Non-distributable configs.
phpunit.xml
.llmsenv

# Playwright / E2E test artifacts.
/artifacts/
/playwright-report/
/test-results/
